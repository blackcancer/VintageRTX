<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.7.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.7.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VintageRTX\VintageRTX.csproj" />
    <ProjectReference Include="..\VintageRTX.DocumentationAnalyzers\VintageRTX.DocumentationAnalyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\VintageRTX.Test\IgnoresAccessChecksToAttribute.cs"
             Link="TestInfrastructure\IgnoresAccessChecksToAttribute.cs" />
    <Compile Include="..\..\tests\VintageRTX.Test\RuntimeCoverageTestDoubles.cs"
             Link="TestInfrastructure\RuntimeCoverageTestDoubles.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\VintageRTX\assets\vintagertx\shaders\display.vert"
             Link="assets\vintagertx\shaders\display.vert"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\VintageRTX\assets\vintagertx\shaders\display.frag"
             Link="assets\vintagertx\shaders\display.frag"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\VintageRTX\assets\vintagertx\shaders\lumarepack.frag"
             Link="assets\vintagertx\shaders\lumarepack.frag"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Core">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Graphics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Common">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Windowing.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Desktop">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Windowing.Desktop.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Windowing.GraphicsLibraryFramework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>$(VintageStoryPath)\Lib\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryPath)\Lib\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Windows retains its required native dependencies. Linux uses the official .so
       files when shipped, or the system GLFW already required by its GL context. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(VintageStoryPath)\Lib\glfw3.dll"
          Link="glfw3.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(VintageStoryPath)\Lib\libSkiaSharp.dll"
          Link="libSkiaSharp.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(VintageStoryPath)/Lib/libSkiaSharp.so"
          Link="libSkiaSharp.so"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(VintageStoryPath)/Lib/libglfw.so*"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
