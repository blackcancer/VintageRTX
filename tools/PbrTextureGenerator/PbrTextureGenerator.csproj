<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SkiaSharp">
      <HintPath>$(VintageStoryPath)\Lib\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(VintageStoryPath)\Lib\libSkiaSharp.dll" Link="libSkiaSharp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidatePbrGeneratorDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(VintageStoryPath)' == '' or !Exists('$(VintageStoryPath)\Lib\SkiaSharp.dll')"
           Text="Vintage Story was not found. Set VINTAGE_STORY to the game installation directory or its assets directory." />
  </Target>
</Project>
