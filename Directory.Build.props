<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Preserve the recovery branch's root/Lib/Mods environment convention.
         An explicit MSBuild VintageStoryPath remains authoritative. Both the
         reference HintPaths and the debugger consume this same resolved root. -->
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and '$(VINTAGE_STORY)' != '' and Exists('$(VINTAGE_STORY)/VintagestoryAPI.dll')">$([System.IO.Path]::GetFullPath('$(VINTAGE_STORY)'))</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and '$(VINTAGE_STORY)' != '' and Exists('$(VINTAGE_STORY)/../VintagestoryAPI.dll')">$([System.IO.Path]::GetFullPath('$(VINTAGE_STORY)/..'))</VintageStoryPath>
  </PropertyGroup>
</Project>
