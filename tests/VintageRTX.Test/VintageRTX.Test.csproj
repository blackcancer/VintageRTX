<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- Keep the existing CLI harness as the executable entry point. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.7.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.7.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VintageRTX\VintageRTX.csproj" />
    <ProjectReference Include="..\VintageRTX.RuntimeTestSupport\VintageRTX.RuntimeTestSupport.csproj" />
    <ProjectReference Include="..\..\tools\VintageRTX.DocumentationAnalyzers\VintageRTX.DocumentationAnalyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\VintageRTX\assets\vintagertx\shaders\display.vert"
             Link="assets\vintagertx\shaders\display.vert"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\VintageRTX\assets\vintagertx\shaders\display.frag"
             Link="assets\vintagertx\shaders\display.frag"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\VintageRTX\assets\vintagertx\shaders\lumarepack.frag"
             Link="assets\vintagertx\shaders\lumarepack.frag"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Core">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Graphics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Common">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Windowing.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Desktop">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Windowing.Desktop.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Windowing.GraphicsLibraryFramework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>$(VintageStoryPath)\Lib\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryPath)\Lib\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>$(VintageStoryPath)\Lib\Microsoft.Data.Sqlite.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2">
      <HintPath>$(VintageStoryPath)\Lib\SQLitePCLRaw.batteries_v2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>$(VintageStoryPath)\Lib\SQLitePCLRaw.core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3">
      <HintPath>$(VintageStoryPath)\Lib\SQLitePCLRaw.provider.e_sqlite3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(VintageStoryPath)\Lib\libSkiaSharp.dll" Condition="Exists('$(VintageStoryPath)/Lib/libSkiaSharp.dll')"
          Link="libSkiaSharp.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(VintageStoryPath)\Lib\glfw3.dll" Condition="Exists('$(VintageStoryPath)/Lib/glfw3.dll')"
          Link="glfw3.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(VintageStoryPath)\Lib\e_sqlite3.dll" Condition="Exists('$(VintageStoryPath)/Lib/e_sqlite3.dll')"
          Link="e_sqlite3.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(VintageStoryPath)/Lib/*.so*" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
