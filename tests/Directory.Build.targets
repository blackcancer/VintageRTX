<Project>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- VSTest collector only: no coverage package or instrumentation in the shipped mod. -->
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
